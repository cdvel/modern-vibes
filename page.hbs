{{!< default}}

<div class="container">
    {{#post}}
    <article class="page">
        <header class="page-header">
            <h1 class="page-title">{{title}}</h1>
            
            {{#if custom_excerpt}}
                <p class="page-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </header>

        {{#if feature_image}}
            <figure class="page-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

        <section class="page-content">
            <div class="content">
                {{content}}
            </div>
        </section>

        {{!-- Contact form for contact page --}}
        {{#is "page" slug="contact"}}
            <section class="contact-form-section">
                <div class="contact-form-container">
                    <h3>Get in touch</h3>
                    <form class="contact-form" action="#" method="post">
                        <div class="form-group">
                            <label for="contact-name">Name</label>
                            <input type="text" id="contact-name" name="name" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="contact-email">Email</label>
                            <input type="email" id="contact-email" name="email" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="contact-subject">Subject</label>
                            <input type="text" id="contact-subject" name="subject" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="contact-message">Message</label>
                            <textarea id="contact-message" name="message" rows="6" required></textarea>
                        </div>
                        
                        <button type="submit" class="contact-submit-btn">Send Message</button>
                    </form>
                </div>
            </section>
        {{/is}}

        {{!-- Now page specific styling --}}
        {{#is "page" slug="now"}}
            <section class="now-page-info">
                <div class="now-page-note">
                    <p><em>This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">"now" page</a>, inspired by Derek Sivers. It's a living document about what I'm focused on at this point in my life.</em></p>
                    <p><small>Last updated: {{date format="MMMM YYYY"}}</small></p>
                </div>
            </section>
        {{/is}}
    </article>
    {{/post}}
</div>