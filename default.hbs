<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <meta name="description" content="{{meta_description}}">
    <meta name="generator" content="Ghost {{@version}}">
    <meta name="robots" content="{{meta_robots}}">
    
    {{!-- Preload fonts --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alata:wght@400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {{!-- FontAwesome for social icons --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    {{!-- Theme styles --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/style.css"}}">
    
    {{!-- Highlight.js for syntax highlighting --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    
    {{!-- TOCbot for table of contents --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.21.1/tocbot.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.21.1/tocbot.min.js"></script>
    
    {{!-- Ghost outputs important meta tags and structured data --}}
    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <div class="site-wrapper">
        {{!-- Header --}}
        <header class="site-header">
            <div class="container">
                <div class="header-content">
                    {{!-- Site logo/avatar --}}
                    {{#if @site.logo}}
                        <div class="site-avatar">
                            <img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}" class="site-avatar-image">
                        </div>
                    {{else}}
                        {{!-- Fallback to author profile image --}}
                        {{#get "users" limit="1" as |authors|}}
                            {{#foreach authors}}
                                {{#if profile_image}}
                                    <div class="site-avatar">
                                        <img src="{{img_url profile_image size="s"}}" alt="{{name}}" class="site-avatar-image">
                                    </div>
                                {{/if}}
                            {{/foreach}}
                        {{/get}}
                    {{/if}}
                    
                    <div class="site-branding">
                        <h1 class="site-title">
                            <a href="{{@site.url}}">{{@site.title}}</a>
                        </h1>
                        {{#if @site.description}}
                            <p class="site-description">{{@site.description}}</p>
                        {{/if}}
                    </div>
                </div>
                
                <nav class="site-nav">
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a href="{{@site.url}}" class="nav-link {{#is "home"}}current{{/is}}">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a href="{{@site.url}}/notes/" class="nav-link {{#is "tag" slug="notes"}}current{{/is}}">Notes</a>
                        </li>
                        <li class="nav-item">
                            <a href="{{@site.url}}/about/" class="nav-link {{#is "page" slug="about"}}current{{/is}}">About</a>
                        </li>
                        <li class="nav-item">
                            <a href="{{@site.url}}/now/" class="nav-link {{#is "page" slug="now"}}current{{/is}}">Now</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>

        {{!-- Main content --}}
        <main class="site-main">
            {{{body}}}
        </main>

        {{!-- Footer --}}
        <footer class="site-footer">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-copyright">
                        <p>&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.</p>
                    </div>
                    
                    <div class="footer-social">
                        <ul class="social">
                            <li><a href="http://x.com/cdvel" class="fab fa-x-twitter" rel="external" target="_blank" title="X(Twitter)" aria-hidden="true"></a><span class="sr-only">X(Twitter)</span></li>
                            <li><a href="https://github.com/cdvel" class="fab fa-github" rel="external" target="_blank" title="GitHub" aria-hidden="true"></a><span class="sr-only">GitHub</span></li>
                            <li><a href="https://huggingface.co/cdvel" class="" style="filter:saturate(0) invert(1) brightness(1)" rel="external" target="_blank" title="Hugging face"><img src="https://huggingface.co/datasets/huggingface/brand-assets/resolve/main/hf-logo-pirate.png" height="20rem"></a></li>
                            <li><a href="https://instagram.com/cdvel" class="fab fa-instagram" rel="external" target="_blank" title="Instagram" aria-hidden="true"></a><span class="sr-only">Instagram</span></li>
                            <li><a href="https://stackoverflow.com/users/4745881?tab=profile" class="fab fa-stack-overflow" rel="external" target="_blank" title="StackOverflow" aria-hidden="true"></a><span class="sr-only">StackOverflow</span></li>
                            <li><a href="https://www.linkedin.com/in/cesarvelandia/" class="fab fa-linkedin-in" rel="external" target="_blank" title="LinkedIn" aria-hidden="true"></a><span class="sr-only">LinkedIn</span></li>
                            <li><a href="{{@site.url}}/rss/" class="fas fa-rss" rel="external" target="_blank" title="RSS Feed" aria-hidden="true"></a><span class="sr-only">RSS Feed</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    {{!-- Ghost outputs important scripts and data --}}
    {{ghost_foot}}
    
    {{!-- Theme scripts --}}
    <script src="{{asset "js/main.js"}}"></script>
</body>
</html>