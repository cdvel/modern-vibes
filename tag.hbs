{{!< default}}

<div class="container">
    <article class="page">
        <header class="page-header">
            <h1 class="page-title">{{name}}</h1>
            {{#if description}}
                <p class="page-excerpt">{{description}}</p>
            {{/if}}
        </header>
        
        {{#if feature_image}}
            <figure class="page-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{name}}">
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}
        
        <div class="tag-meta">
            <p class="tag-count">{{plural ../pagination.total empty='No posts' singular='% post' plural='% posts'}}</p>
        </div>
    </article>

    <section class="tag-posts">
        <div class="posts-container grid-layout">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>

        {{pagination}}
    </section>
</div>