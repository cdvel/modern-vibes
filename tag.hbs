{{!< default}}

<div class="container">
    <header class="tag-header">
        <h1 class="tag-name">{{name}}</h1>
        {{#if description}}
            <p class="tag-description">{{description}}</p>
        {{/if}}
        <p class="tag-count">{{plural ../pagination.total empty='No posts' singular='% post' plural='% posts'}}</p>
    </header>

    <section class="tag-posts">
        {{!-- View Toggle --}}
        <div class="view-controls">
            <button class="view-toggle grid-view active" data-view="grid" aria-label="Grid view">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 3h7v7H3V3zm0 11h7v7H3v-7zm11-11h7v7h-7V3zm0 11h7v7h-7v-7z"/>
                </svg>
            </button>
            <button class="view-toggle list-view" data-view="list" aria-label="List view">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                </svg>
            </button>
        </div>

        <div class="posts-container grid-layout" id="posts-container">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>

        {{!-- Load More Button --}}
        {{#if pagination.next}}
            <div class="load-more-container">
                <button class="load-more-btn"
                        data-next-page="{{pagination.next}}"
                        id="load-more-btn">
                    Load More Posts
                </button>
                <div class="loading-spinner hidden" id="loading-spinner">
                    <div class="spinner"></div>
                </div>
            </div>
        {{/if}}
    </section>
</div>