{
  "name": "modern-vibes",
  "description": "A clean, sleek, and modern Ghost theme with great vibes - featuring grid/list toggle and smooth interactions",
  "version": "1.1.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "CD Velandia",
    "email": "cesar@velandia.co"
  },
  "keywords": [
    "ghost",
    "theme",
    "personal",
    "blog",
    "modern",
    "vibes",
    "clean",
    "responsive"
  ],
  "config": {
    "posts_per_page": 12,
    "custom": {
      "navigation_layout": {
        "type": "select",
        "options": ["Logo on the left", "Logo in the center"],
        "default": "Logo on the left"
      },
      "show_publication_cover": {
        "type": "boolean",
        "default": true
      },
      "hide_post_thumbnails": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
