<article class="post-card" data-post-id="{{id}}" data-post-url="{{url}}">
    <div class="post-image">
        <a href="{{url}}">
            {{#if feature_image}}
                <img src="{{img_url feature_image size="m"}}" 
                     alt="{{title}}" 
                     loading="lazy"
                     class="post-feature-image">
            {{else}}
                <div class="post-image-placeholder" title="{{title}}"></div>
            {{/if}}
        </a>
    </div>
    
    <div class="post-content">
        <header class="post-header">
            {{#if primary_tag}}
                <span class="post-tag">{{primary_tag.name}}</span>
            {{/if}}
            
            <h2 class="post-title">
                <a href="{{url}}">{{title}}</a>
            </h2>
            
            <div class="post-meta">
                <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">
                    {{date format="MMM DD, YYYY"}}
                </time>
                {{#if reading_time}}<span class="post-reading-time">{{reading_time}}</span>{{/if}}
            </div>
        </header>
        
        <div class="post-excerpt">
            <p>
                {{#if excerpt}}
                    {{excerpt words="30"}}
                {{else}}
                    {{#if custom_excerpt}}
                        {{custom_excerpt}}
                    {{else}}
                        Read more about {{title}}...
                    {{/if}}
                {{/if}}
            </p>
        </div>
        
        <footer class="post-footer">
            <a href="{{url}}" class="read-more">Read more →</a>
        </footer>
    </div>
</article>